{
  "name": "vibecrafthub",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma para que empleados publiquen apps web internas de forma segura",
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter api dev",
    "dev:portal": "pnpm --filter portal dev",
    "test:scanner": "pnpm --filter scanner test"
  }
}
